{
    "template": "dispatcher",
    "fields": [
        { "id": "org", "label": "Организация", "type": "select", "required": true, "source": "ORGS", "validate": { "rule": "eq", "path": "orgId" } },
        { "id": "cont", "label": "Контактное лицо", "type": "select", "required": true, "source": "CONTACTS_BY_ORG", "validate": { "rule": "eq", "path": "contactId" } },
        { "id": "chan", "label": "Канал связи", "type": "select", "required": true, "options": ["Email", "Телефон", "Портал самообслуживания", "Чат на сайте", "Мессенджер"], "validate": { "rule": "eq", "path": "channel" } },
        { "id": "title", "label": "Заголовок", "type": "text", "required": true },
        { "id": "desc", "label": "Описание ситуации", "type": "textarea", "required": true },
        { "id": "type", "label": "Тип обращения *", "type": "select", "required": true, "options": ["Инцидент", "Запрос на обслуживание", "Консультация"], "validate": { "rule": "eq", "path": "type" } },
        { "id": "prod", "label": "Продукт *", "type": "select", "required": true, "source": "PRODUCTS_BY_ORG", "validate": { "rule": "eq", "path": "prod" } },
        { "id": "cat", "label": "Категория *", "type": "select", "required": true, "source": "TAX_CATEGORIES", "validate": { "rule": "eq", "path": "cat" } },
        { "id": "sub", "label": "Подкатегория *", "type": "select", "required": true, "source": "TAX_SUBCATEGORIES", "validate": { "rule": "eq", "path": "sub" } },
        { "id": "vers", "label": "Продукты и версии", "type": "versions", "required": true, "validate": { "rule": "includes", "path": "ver" } },
        { "id": "imp", "label": "Важность *", "type": "select", "required": true, "options": ["высокая", "средняя", "низкая"], "validate": { "rule": "eq", "path": "imp" } },
        { "id": "urg", "label": "Срочность *", "type": "select", "required": true, "options": ["высокая", "средняя", "низкая"], "validate": { "rule": "eq", "path": "urg" } },
        { "id": "assignee", "label": "Назначить ответственного *", "type": "select", "required": true, "source": "EMPLOYEES", "validate": { "rule": "eq", "path": "expectedAssignee" } },
        { "id": "comment", "label": "Комментарий / Задача для исполнителя *", "type": "select", "required": true, "source": "COMMENTS_L2", "validate": { "rule": "eq", "path": "expectedComment" } }
    ]
}
