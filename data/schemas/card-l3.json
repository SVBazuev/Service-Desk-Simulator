{
    "fields": [
        { "id": "root", "label": "Корневая причина (своими словами) *", "type": "textarea", "required": true, "validate": { "rule": "keywords", "path": "rootKeywords" } },
        { "id": "workaround", "label": "Обходное решение (workaround) *", "type": "select", "required": true, "source": "WORKAROUNDS", "validate": { "rule": "eqIndex", "path": "workaroundCorrect" } },
        { "id": "radical", "label": "Радикальное решение *", "type": "select", "required": true, "source": "RADICAL", "validate": { "rule": "eqIndex", "path": "radicalCorrect" } },
        {
            "id": "outcome",
            "label": "Исход обращения *",
            "type": "select",
            "required": true,
            "options": [
                { "value": "resolved", "label": "Решено (инцидент закрыт, проблемы нет)" },
                { "value": "new_problem", "label": "Новая проблема (требуется завести Problem Record)" },
                { "value": "known_error", "label": "Известная ошибка (привязка к существующей проблеме, ждем фикс)" },
                { "value": "fixed_problem", "label": "Исправленная проблема (привязка к закрытой проблеме, рецидив)" }
            ],
            "validate": { "rule": "l3_logic" }
        },
        {
            "id": "problemBlock",
            "type": "composite",
            "title": "Управление проблемами: Problem Record *",
            "showIf": { "field": "outcome", "eq": "new_problem" },
            "fields": [
                { "id": "incidents", "label": "Связанные инциденты", "type": "checkboxGroup", "source": "problem.incidentsLinked", "fallback": "currentTicket" },
                { "id": "impact", "label": "Влияние *", "type": "select", "options": [{ "value": "высокое", "label": "высокое - затронуты бизнес-процессы нескольких организаций" }, { "value": "среднее", "label": "среднее - затронут процесс одной организации" }, { "value": "низкое", "label": "низкое" }] },
                { "id": "prob", "label": "Вероятность повторения *", "type": "select", "options": [{ "value": "высокая", "label": "высокая" }, { "value": "средняя", "label": "средняя" }, { "value": "низкая", "label": "низкая" }] },
                { "id": "owner", "label": "Владелец проблемы *", "type": "select", "source": "EMPLOYEES_L3" },
                { "id": "method", "label": "Метод расследования *", "type": "select", "source": "PROBLEM_METHODS" },
                { "id": "rfc", "label": "RFC - запрос на изменение для разработчиков *", "type": "textarea" }
            ]
        },
        {
            "id": "linkedProb",
            "label": "Связанная проблема *",
            "type": "select",
            "source": "PROBLEMS",
            "showIf": { "field": "outcome", "in": ["known_error", "fixed_problem"] }
        }
    ]
}
